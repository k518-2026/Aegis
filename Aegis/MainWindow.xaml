<Window x:Class="Aegis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Aegis.Views"
        Title="Aegis - セキュリティスイート" Height="820" Width="1240"
        MinHeight="620" MinWidth="980"
        Background="{StaticResource BgBrush}"
        Icon="Resources/aegis.ico"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18,14,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="Resources/aegis.ico" Width="38" Height="38"
                   Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Aegis セキュリティスイート" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Caption}"
                           Text="ファイル検査・フィッシング判定・システム診断" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="AdminText" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button x:Name="AdminButton" Content="管理者として実行" Click="AdminButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush2}" Margin="0,0,0,6" />

        <!-- タブ -->
        <TabControl Grid.Row="2">
            <TabItem Header="ファイル検査">
                <views:ScanView x:Name="ScanPage" />
            </TabItem>
            <TabItem Header="リアルタイム監視">
                <views:MonitorView x:Name="MonitorPage" />
            </TabItem>
            <TabItem Header="ClamAV で検査">
                <views:ClamAvView x:Name="ClamAvPage" />
            </TabItem>
            <TabItem Header="隔離ボックス">
                <views:QuarantineView x:Name="QuarantinePage" />
            </TabItem>
            <TabItem Header="フィッシング判定">
                <views:PhishingView x:Name="PhishingPage" />
            </TabItem>
            <TabItem Header="システム診断">
                <views:SystemView x:Name="SystemPage" />
            </TabItem>
            <TabItem Header="自動起動の確認">
                <views:AutorunView x:Name="AutorunPage" />
            </TabItem>
        </TabControl>

        <!-- ステータスバー -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="6"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                Padding="12,6" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Text="準備完了" />
                <TextBlock x:Name="DbText" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
