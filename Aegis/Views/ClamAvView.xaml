<UserControl x:Class="Aegis.Views.ClamAvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <!-- 旧 VirusScannerApp（ClamAV のフロントエンド）を 2026-11-02 に統合 -->
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="130" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="ClamAV で検査" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="オープンソースのウイルス対策エンジン ClamAV の定義ファイル（数百万件）で調べます。Aegis 自身の検査（ファイル検査タブ）とは別の、外部のエンジンです。初回は「定義ファイルを更新」でおよそ 300 MB をダウンロードします。" />
                <TextBlock x:Name="EngineText" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="DbStateText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <WrapPanel>
                <Button x:Name="ScanButton" Content="フォルダーを検査…" Style="{StaticResource PrimaryButton}" Click="Scan_Click" />
                <Button x:Name="UpdateButton" Content="定義ファイルを更新" Click="Update_Click" />
                <Button x:Name="CancelButton" Content="中止" Click="Cancel_Click" IsEnabled="False" />
                <Button x:Name="ChooseButton" Content="ClamAV の場所を選ぶ…" Click="Choose_Click" />
            </WrapPanel>
            <ProgressBar x:Name="Progress" Height="6" Margin="0,8,0,0" IsIndeterminate="False" />
            <TextBlock x:Name="ProgressText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
        </StackPanel>

        <DataGrid x:Name="HitGrid" Grid.Row="2" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="時刻" Binding="{Binding TimeText}" Width="70" />
                <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="220" />
                <DataGridTextColumn Header="検出名（ClamAV）" Binding="{Binding RuleName}" Width="240" />
                <DataGridTextColumn Header="サイズ" Binding="{Binding SizeText}" Width="80" />
                <DataGridTextColumn Header="場所" Binding="{Binding FilePath}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="3" Margin="0,10,0,8">
            <Button Content="選んだものを隔離" Click="Quarantine_Click" />
            <Button Content="場所を開く" Click="Reveal_Click" />
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0"
                       Text="隔離したファイルは「隔離ボックス」タブで元に戻せます。" />
        </WrapPanel>

        <TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Meiryo UI" FontSize="12" />
    </Grid>
</UserControl>
