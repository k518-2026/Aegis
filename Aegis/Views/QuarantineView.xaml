<UserControl x:Class="Aegis.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="隔離ボックス" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Caption}"
                           Text="隔離したファイルは中身を変換して保管しているため、そのままでは実行されません。誤検出だった場合は「元に戻す」で復元できます。" />
                <TextBlock x:Name="PathText" Style="{StaticResource Caption}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="Grid1" Grid.Row="1" ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="隔離日時" Binding="{Binding DateText}" Width="140" />
                <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="220" />
                <DataGridTextColumn Header="サイズ" Binding="{Binding SizeText}" Width="80" />
                <DataGridTextColumn Header="検出理由" Binding="{Binding RuleName}" Width="220" />
                <DataGridTextColumn Header="元の場所" Binding="{Binding OriginalPath}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="一覧を更新" Click="Refresh_Click" />
            <Button Content="元に戻す" Click="Restore_Click" />
            <Button Content="別の場所に取り出す" Click="RestoreAs_Click" />
            <Button Content="完全に削除" Click="Delete_Click" />
            <Button Content="隔離フォルダを開く" Click="OpenFolder_Click" />
        </WrapPanel>
    </Grid>
</UserControl>
