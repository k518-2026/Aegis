<UserControl x:Class="Aegis.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="システム診断" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Caption}"
                           Text="Windows の保護設定を読み取って点検します。設定の書き換えは行いません（読み取りのみ）。" />
                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}"
                            Content="診断を実行" Click="Run_Click" />
                    <Button Content="Windows セキュリティを開く" Click="OpenSecurity_Click" />
                    <Button Content="HTMLレポート" Click="Export_Click" />
                </WrapPanel>
                <TextBlock x:Name="SummaryText" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="CheckGrid" Grid.Column="0" ItemsSource="{Binding Checks}"
                      SelectionChanged="CheckGrid_SelectionChanged" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="状態" Binding="{Binding StatusText}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding StatusColor}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="分類" Binding="{Binding Category}" Width="120" />
                    <DataGridTextColumn Header="項目" Binding="{Binding Name}" Width="260" />
                    <DataGridTextColumn Header="内容" Binding="{Binding Detail}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="推奨される対処" Style="{StaticResource H1}" />
                        <TextBlock x:Name="AdviceTitle" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="項目を選ぶと表示されます。" />
                        <TextBlock x:Name="AdviceDetail" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                        <TextBlock x:Name="AdviceText" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
