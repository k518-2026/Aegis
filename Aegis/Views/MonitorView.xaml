<UserControl x:Class="Aegis.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="リアルタイム監視" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Caption}"
                           Text="指定したフォルダに新しく現れたファイルを、その場で検査します。ダウンロード直後やUSBからのコピー直後の確認に向いています。常駐型ウイルス対策ソフトの置き換えではありません。" />
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}"
                            Content="監視を開始" Click="Start_Click" />
                    <Button x:Name="StopButton" Content="監視を停止" IsEnabled="False" Click="Stop_Click" />
                    <Button Content="監視フォルダを追加" Click="AddFolder_Click" />
                    <Button Content="選択したフォルダを外す" Click="RemoveFolder_Click" />
                </WrapPanel>
                <CheckBox x:Name="AutoQuarantineCheck" Margin="0,10,0,0"
                          Content="危険度が高い検出は自動で隔離する（既定はオフ）" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="監視中のフォルダ" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                <ListBox x:Name="FolderList" Height="94" />
                <TextBlock x:Name="MonitorStatus" Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Text="停止中" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="EventGrid" Grid.Row="2" ItemsSource="{Binding Events}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="時刻" Binding="{Binding TimeText}" Width="80" />
                <DataGridTextColumn Header="危険度" Binding="{Binding LevelText}" Width="95">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding LevelColor}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="検出ルール" Binding="{Binding RuleName}" Width="220" />
                <DataGridTextColumn Header="ファイル" Binding="{Binding FilePath}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
